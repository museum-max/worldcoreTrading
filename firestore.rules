rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'joaquineleonardo@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Paper Trades collection
    match /trades/{tradeId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Price Alerts collection
    match /priceAlerts/{alertId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
    }
  }
}
