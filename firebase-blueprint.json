{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with paper trading demo balances and wallet credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "walletAddress": { "type": "string", "maxLength": 64 },
        "ctContractAddress": { "type": "string", "maxLength": 64 },
        "demoUsdBalance": { "type": "string", "maxLength": 32 },
        "demoEthBalance": { "type": "string", "maxLength": 32 },
        "demoCtBalance": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Administrator privilege registry record controlled exclusively by verified platform admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "grantedBy", "updatedAt"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Simulated paper trade execution record",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "enum": ["market", "limit"] },
        "side": { "type": "string", "enum": ["buy", "sell"] },
        "price": { "type": "string", "maxLength": 32 },
        "amount": { "type": "string", "maxLength": 32 },
        "total": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["filled", "open", "cancelled"] },
        "pnl": { "type": "string", "maxLength": 32 },
        "ctContractAddress": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["userUid", "symbol", "type", "side", "price", "amount", "total", "status"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Target price alert threshold set by a user",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "targetPrice": { "type": "string", "maxLength": 32 },
        "condition": { "type": "string", "enum": ["ABOVE", "BELOW"] },
        "status": { "type": "string", "enum": ["ACTIVE", "TRIGGERED"] },
        "note": { "type": "string", "maxLength": 256 },
        "triggeredAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["userUid", "symbol", "targetPrice", "condition", "status"]
    },
    "UserNft": {
      "title": "UserNft",
      "description": "Minted or acquired WorldCore Sovereign NFT relic",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "maxLength": 128 },
        "tokenId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "edition": { "type": "string", "maxLength": 64 },
        "collection": { "type": "string", "maxLength": 128 },
        "image": { "type": "string", "maxLength": 1024 },
        "rarity": { "type": "string", "maxLength": 64 },
        "pricePaid": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "enum": ["CT", "ETH", "USD"] },
        "txHash": { "type": "string", "maxLength": 128 },
        "ownerAddress": { "type": "string", "maxLength": 64 },
        "acquiredAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["userUid", "tokenId", "name", "pricePaid", "currency"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Global platform configuration including Maintenance Mode flag and notice message",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 64 },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["key", "maintenanceMode", "maintenanceMessage", "updatedBy", "updatedAt"]
    },
    "CtTraderContract": {
      "title": "CtTraderContract",
      "description": "Deterministic per-user CoreToken (CT) trading settlement contract address record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "ctContractAddress": { "type": "string", "maxLength": 64, "pattern": "^0x[a-fA-F0-9]{40}$" },
        "tokenContract": { "type": "string", "maxLength": 64, "pattern": "^0x[a-fA-F0-9]{40}$" },
        "network": { "type": "string", "maxLength": 128 },
        "chainId": { "type": "integer" },
        "assignedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "ctContractAddress", "tokenContract", "chainId", "updatedAt"]
    },
    "CtStake": {
      "title": "CtStake",
      "description": "Simulated CoreToken (CT) staking vault position with annual percentage yield (APY) and lock period tracking",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "maxLength": 128 },
        "amountCt": { "type": "number" },
        "apyPercent": { "type": "number" },
        "lockDays": { "type": "integer" },
        "tierLabel": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "UNSTAKED"] },
        "claimedYieldCt": { "type": "number" },
        "stakedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "unlockAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "lastClaimAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "unstakedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": [
        "userUid",
        "amountCt",
        "apyPercent",
        "lockDays",
        "tierLabel",
        "status",
        "claimedYieldCt",
        "stakedAt",
        "unlockAt",
        "lastClaimAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile records containing demo balances and credentials"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Administrator privilege registry readable by the grantee or admins, writable strictly by verified admins"
    },
    "/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Simulated paper trading history and executions"
    },
    "/priceAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "Configured user price alerts and target thresholds"
    },
    "/user_nfts/{nftId}": {
      "schema": { "$ref": "#/entities/UserNft" },
      "description": "User owned WorldCore NFT collectibles and certificates"
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Global operational settings (publicly readable via get, strictly writable only by verified admins)"
    },
    "/ct_contracts/{contractUserId}": {
      "schema": { "$ref": "#/entities/CtTraderContract" },
      "description": "Per-user deterministic CoreToken (CT) trading contract address registry"
    },
    "/ct_stakes/{stakeId}": {
      "schema": { "$ref": "#/entities/CtStake" },
      "description": "CoreToken (CT) simulated staking vaults tracking locked balances and accrued annual yield"
    }
  }
}
